# ucxapp_embed(<input> <output.h> <array> [GZIP] [NUL])
# Writes <array> as a C byte array of <input> (string literals hit compiler length limits). GZIP stores the
# gzip-compressed file (served with Content-Encoding: gzip) and defines <array>_GZIP; NUL appends a 0 byte.
function(ucxapp_embed input output array)
  cmake_parse_arguments(ARG "GZIP;NUL" "" "" ${ARGN})
  set(src ${input})
  if(ARG_GZIP)
    get_filename_component(_name ${input} NAME)
    set(src ${CMAKE_CURRENT_BINARY_DIR}/embed/${_name}.gz)
    file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/embed)
    file(ARCHIVE_CREATE OUTPUT ${src} PATHS ${input} FORMAT raw COMPRESSION GZip COMPRESSION_LEVEL 9)
  endif()
  file(READ ${src} _hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" _hex "${_hex}")
  set(_tail "")
  set(_defs "")
  if(ARG_NUL)
    set(_tail "0x00")
  endif()
  if(ARG_GZIP)
    set(_defs "#define ${array}_GZIP 1\n")
  endif()
  file(WRITE ${output}.tmp
    "/* Generated from ${input} by CMake; do not edit. */\n${_defs}static const unsigned char ${array}[] = {\n${_hex}${_tail}\n};\n")
  configure_file(${output}.tmp ${output} COPYONLY)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${input})
endfunction()
