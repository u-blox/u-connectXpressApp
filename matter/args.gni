# Build arguments of the Matter plug-in; "ucxapp --matter" adds target_os and target_cpu for the host, and on
# Windows the include path of compat/windows.

is_debug = false
symbol_level = 0

# GCC (MinGW-w64 on Windows): the Matter SDK does not build with MSVC
is_clang = false
treat_warnings_as_errors = false

# The SDK's default is OpenSSL, found with pkg-config. The PSA backend runs on the app's mbedTLS 4
# (//mbedtls, build_overrides/mbedtls.gni) instead of the SDK's end-of-life mbedTLS 2.28. Its session keys
# must be PSA keys: the PSA AES-CCM takes the key handle as a PSA key id, so with the raw keystore every
# message after PASE fails to decrypt. The operational keys live in the node's storage either way
# (PersistentStorageOperationalKeystore), which goes through the app's secure store.
chip_crypto = "psa"
chip_crypto_keystore = "psa"

chip_build_tests = false

# The device layer is platform/ucxclient: the module is the radio and the IP stack
chip_device_platform = "external"
chip_platform_target = "//platform/ucxclient"
chip_external_platform_include_dir = "//"
chip_device_platform_config_include =
    "<platform/ucxclient/CHIPDevicePlatformConfig.h>"
chip_platform_config_include = "<platform/ucxclient/CHIPPlatformConfig.h>"
chip_system_platform_config_include =
    "<platform/ucxclient/SystemPlatformConfig.h>"
chip_inet_platform_config_include = "<platform/ucxclient/InetPlatformConfig.h>"

# Commissioning over Bluetooth LE
chip_enable_ble = true
chip_config_network_layer_ble = true

# UDP through the module's sockets; no TCP (the node needs none and the module has six sockets)
chip_system_config_use_ucx = true
chip_system_config_use_lwip = false
chip_inet_config_enable_tcp_endpoint = false

# mDNS on the module (AT+UMD*), never the SDK's responder on the host: that one needs multicast sockets through
# the module and wakes the host for every query on the network
chip_mdns = "platform"

# A device, not a controller: it reads no other node. It does not keep its subscriptions over a restart either:
# to take one up again the node has to find the controller, and the module's mDNS answers queries but sends
# none (ChipDnssdResolve). Every start of a commissioned node then logged "Failed to establish CASE for
# subscription-resumption" and tried again. The controller subscribes anew when it sees the node.
chip_enable_read_client = false
chip_persist_subscriptions = false

# Lets the SDK's cluster code see the node's data model
chip_app_data_model_target = "//:ucxmatter-data-model"

# The Python environment of the build actions: BUILD.gn
pw_build_PYTHON_BUILD_VENV = "//:build_venv"
