# Production test for a NORA-W36: identity, Wi-Fi, network, MQTT, Bluetooth LE.
# Set UCX_WIFI_SSID and UCX_WIFI_PASS first (the password never appears in the report).
#   ucxapp --script examples/automation/production-test.ucx --junit production.xml
dev.info
expect Model:\s+NORA-W36
dev.caps
expect Wi-Fi:\s+yes
wifi.connect ${UCX_WIFI_SSID} ${UCX_WIFI_PASS}
wifi.status
net.dns u-blox.com
net.ping u-blox.com 2
mqtt.connect
mqtt.publish ucxapp/production hello
mqtt.disconnect
bt.scan
dev.diagnose
expect Result:\s+PASS
