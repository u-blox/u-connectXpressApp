# The Matter plug-in of u-connectXpressApp: ucxmatter.dll / libucxmatter.so, loaded by the app's matter.* commands
# (app/src/ucxapp_matter.h). Built by "ucxapp --matter"; the Matter SDK in connectedhomeip/ is used as it is.

import("//build_overrides/chip.gni")
import("//build_overrides/pigweed.gni")
import("$dir_pw_build/python_venv.gni")
import("${chip_root}/src/app/chip_data_model.gni")

declare_args() {
  # Shown by matter.status; "ucxapp --matter" passes the tag of the SDK checkout.
  ucxm_sdk_version = "unknown"

  # For the plug-in's bill of materials (app.sbom): the commits of the SDK checkout and of its parts in the
  # plug-in, also from "ucxapp --matter".
  ucxm_sdk_commit = "unknown"
  ucxm_mbedtls_commit = "unknown"
  ucxm_pigweed_commit = "unknown"
  ucxm_nlassert_commit = "unknown"
  ucxm_nlio_commit = "unknown"
}

_client = "../u-connectClient"
_api = "${_client}/ucx_api/generated/MERGED"

config("ucx_config") {
  include_dirs = [
    "src",
    "../app/src",
    "${_client}/inc",
    "${_client}/ports",
    "${_client}/ucx_api",
    _api,
  ]

  # The same port as the app, so both see the same uCxAtClient_t
  if (current_os == "win") {
    defines = [ "U_PORT_WINDOWS" ]
  } else {
    defines = [ "U_PORT_POSIX" ]
  }
}

# The u-connectXpress API of the app's own u-connectClient. Its AT client calls go to the app (src/ucxm_at.h),
# and src/ucxm_host.c stands in for u_cx.c.
source_set("ucx_api") {
  sources = [
    "${_api}/u_cx_bluetooth.c",
    "${_api}/u_cx_error_codes.c",
    "${_api}/u_cx_gatt_server.c",
    "${_api}/u_cx_general.c",
    "${_api}/u_cx_mdns.c",
    "${_api}/u_cx_socket.c",
    "${_api}/u_cx_system.c",
    "${_api}/u_cx_urc.c",
    "${_api}/u_cx_wifi.c",
    "${_client}/src/u_cx_at_params.c",
    "${_client}/src/u_cx_at_util.c",
    "src/ucxm_at.h",
    "src/ucxm_host.c",
    "src/ucxm_host.h",
  ]
  cflags = [
    "-include",
    rebase_path("src/ucxm_at.h", root_build_dir),
  ]
  public_configs = [ ":ucx_config" ]
}

# The Python environment of the SDK's build actions (args.gni points the build at it). They only copy the
# checked-in data model code, so it has what the SDK's code generator package asks for (click, jinja2, lark):
# the SDK's default one installs dozens more from the network, and some of those do not build on a new Python.
pw_python_venv("build_venv") {
  path = "$root_build_dir/python-venv"
  constraints = [ "python_constraints.txt" ]
  requirements = []
  source_packages = [ "${chip_root}/scripts/py_matter_idl:matter-idl" ]
}

# The node's data model: root node, dimmable light, temperature sensor, contact sensor. The code generated from
# it is checked in under data_model/ucxmatter ("ucxapp --matter --zap" makes it), so a build needs no ZAP tool.
chip_data_model("ucxmatter-data-model") {
  zap_file = "data_model/ucxmatter.zap"
  is_server = true
}

shared_library("ucxmatter") {
  sources = [
    "src/UbloxCommissionableDataProvider.cpp",
    "src/UbloxCommissionableDataProvider.h",
    "src/callbacks.cpp",
    "src/endpoints.cpp",
    "src/endpoints.h",
    "src/logging.cpp",
    "src/node.cpp",
    "src/node.h",
    "src/onboarding.cpp",
    "src/onboarding.h",
    "src/plugin.cpp",
    "src/progress.cpp",
    "src/progress.h",
  ]
  defines = [
    "UCXM_SDK_VERSION=\"${ucxm_sdk_version}\"",
    "UCXM_SDK_COMMIT=\"${ucxm_sdk_commit}\"",
    "UCXM_MBEDTLS_COMMIT=\"${ucxm_mbedtls_commit}\"",
    "UCXM_PIGWEED_COMMIT=\"${ucxm_pigweed_commit}\"",
    "UCXM_NLASSERT_COMMIT=\"${ucxm_nlassert_commit}\"",
    "UCXM_NLIO_COMMIT=\"${ucxm_nlio_commit}\"",
  ]
  deps = [
    ":ucx_api",
    ":ucxmatter-data-model",
    "${chip_root}/src/app/clusters/boolean-state-server",
    "${chip_root}/src/app/server",
    "${chip_root}/src/crypto",
    "${chip_root}/src/lib",
    "${chip_root}/src/lib/support",
    "${chip_root}/src/platform",
    "${chip_root}/src/platform/logging:headers",
    "${chip_root}/src/setup_payload",
  ]
  output_dir = root_out_dir
  if (current_os == "win") {
    output_extension = "dll"

    # One file next to the app: the GCC runtime is linked in, only Windows' own DLLs are needed
    ldflags = [ "-static" ]
  }
}

group("default") {
  deps = [ ":ucxmatter" ]
}
